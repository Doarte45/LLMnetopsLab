set system host-name HQ

set interfaces ethernet eth0 address 10.10.0.1/22
set interfaces ethernet eth1 address 172.16.7.1/30
set interfaces ethernet eth2 address 172.16.7.5/30
set interfaces loopback lo address 209.165.202.129/30

set protocols ospf area 0 network 10.10.0.0/22
set protocols ospf area 0 network 172.16.7.0/30
set protocols ospf area 0 network 172.16.7.4/30
set protocols ospf default-information originate
set protocols ospf interface eth0 passive
set protocols ospf interface lo passive

set protocols static route 0.0.0.0/0 interface lo
