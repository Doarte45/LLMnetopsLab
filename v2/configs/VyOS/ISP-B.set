set system host-name ISP-B

set interfaces ethernet eth0 address 203.0.113.5/30
set interfaces loopback lo address 1.1.1.1/32

set policy route-map PERMIT-ALL rule 10 action permit

set protocols bgp system-as 65200
set protocols bgp parameters router-id 1.1.1.1
set protocols bgp address-family ipv4-unicast network 1.1.1.1/32
set protocols bgp neighbor 203.0.113.6 remote-as 65000
set protocols bgp neighbor 203.0.113.6 address-family ipv4-unicast default-originate
set protocols bgp neighbor 203.0.113.6 address-family ipv4-unicast route-map import PERMIT-ALL
set protocols bgp neighbor 203.0.113.6 address-family ipv4-unicast route-map export PERMIT-ALL
